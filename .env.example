PORT=3000
HOST_PORT=3055
MELODASH_HOST_PORT=55026
MELODASH_IMAGE=ghcr.io/melodarr/melodarr-proxy-melodash:latest
REDIS_URL=redis://localhost:6379
ADMIN_PASSWORD=
REQUIRE_API_KEY=true
SETTINGS_SESSION_SECRET=
JWT_SECRET=super-secret-key
DATA_DIR=/data
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_API_KEY=
MUSICBRAINZ_IP_FAMILY=4
CACHE_TTL_SECONDS=86400
UPSTREAM_TIMEOUT_MS=8000
SERVER_TIMEOUT_MS=15000
GLOBAL_RATE_LIMIT_MAX=500
MAX_CONCURRENT_REQUESTS=20
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_RETRY_BASE_MS=500
UPSTREAM_RETRY_MAX_MS=30000
SLOW_REQUEST_MS=2000
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_MS=600000
PROVIDER_REENABLE_SUCCESS_THRESHOLD=3
PROVIDER_REENABLE_WINDOW_MS=300000

APP_NAME=melodarr-proxy
APP_VERSION=0.3.42
APP_CONTACT=https://github.com/melodarr/melodarr-proxy

# Comma-separated. Low-call options: musicbrainz,theaudiodb,itunes,lastfm,discogs
METADATA_PROVIDERS=musicbrainz,itunes
PROVIDER_PRIORITY=musicbrainz,theaudiodb,itunes,lastfm,discogs

# Optional provider credentials
THEAUDIODB_API_KEY=
LASTFM_API_KEY=
DISCOGS_TOKEN=
ITUNES_COUNTRY=US

# Optional live provider integration tests. These are not used by normal PR tests.
REAL_PROVIDER_INTEGRATION=false
REAL_PROVIDER_PROVIDERS=musicbrainz,itunes
REAL_PROVIDER_ARTIST=Radiohead
REAL_PROVIDER_MIN_ALBUMS=1
REAL_PROVIDER_AGGREGATE=false

# Optional custom provider configuration (JSON array format)
# CUSTOM_PROVIDERS='[{"name":"Custom API","baseUrl":"https://api.example.com","searchPath":"/search","queryParam":"q","authType":"none"}]'
# Legacy singular variables below are deprecated; migrate to CUSTOM_PROVIDERS JSON array
CUSTOM_PROVIDER_NAME=Custom API
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_SEARCH_PATH=
CUSTOM_PROVIDER_QUERY_PARAM=q
CUSTOM_PROVIDER_AUTH_TYPE=none
CUSTOM_PROVIDER_HEADER_NAME=
CUSTOM_PROVIDER_QUERY_AUTH_NAME=
CUSTOM_PROVIDER_TOKEN=
CUSTOM_PROVIDER_MAPPING={}

# Optional alerts
ALERT_SLACK_WEBHOOK=
