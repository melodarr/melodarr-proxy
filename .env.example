PORT=3000
HOST_PORT=0
DEVDASH_HOST_PORT=55026
REDIS_URL=redis://localhost:6379
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_IP_FAMILY=6

APP_NAME=melodarr-proxy
APP_VERSION=0.2.0
APP_CONTACT=your@email.com

# Comma-separated. Low-call options: musicbrainz,theaudiodb,itunes,lastfm,discogs
METADATA_PROVIDERS=musicbrainz,itunes
PROVIDER_PRIORITY=musicbrainz,theaudiodb,itunes,lastfm,discogs

# Optional provider credentials
THEAUDIODB_API_KEY=
LASTFM_API_KEY=
DISCOGS_TOKEN=
ITUNES_COUNTRY=US
