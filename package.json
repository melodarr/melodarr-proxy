{
  "name": "melodarr-proxy",
  "version": "0.3.47",
  "description": "Lightweight multi-provider music metadata proxy for Melodarr.",
  "main": "src/server.js",
  "type": "commonjs",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "reset-password": "node src/server.js --reset-password",
    "lint": "XDG_CACHE_HOME=.cache standard",
    "test": "node --test src/**/*.test.js",
    "test:unit": "find src -name '*.test.js' -not -path 'src/e2e/*' -print0 | xargs -0 node --test --test-force-exit",
    "test:contracts": "node --test src/contracts/**/*.test.js",
    "test:e2e": "node --test src/e2e/**/*.e2e.test.js",
    "test:e2e:real": "E2E_REAL_HTTP=true node --test src/e2e/**/*.e2e.test.js",
    "test:providers:real": "REAL_PROVIDER_INTEGRATION=true node --test src/integration/**/*.test.js",
    "test:compose": "bash scripts/docker-compose-smoke.sh",
    "test:melodash-routes": "bash scripts/melodash-route-smoke.sh",
    "docker:lint": "docker compose --profile test run --rm test yarn lint",
    "docker:test": "docker compose --profile test run --rm test sh -c 'yarn test && yarn test:e2e'",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "express": "^4.18.3",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "standard": "^17.1.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "standard": {
    "ignore": [
      "test-mock*.js",
      "test-lorde.js",
      "test-uuid.js",
      "test_*.js",
      "tmp/",
      "*.scratch.js"
    ]
  }
}
