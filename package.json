{
  "name": "melodarr-proxy",
  "version": "0.1.0",
  "description": "Lightweight multi-provider music metadata proxy for Melodarr.",
  "main": "src/server.js",
  "type": "commonjs",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "reset-password": "node src/server.js --reset-password",
    "lint": "XDG_CACHE_HOME=.cache standard",
    "lint:auth": "node --check auth-service/server.js",
    "lint:devdash": "docker compose exec devdash npx tsc --noEmit",
    "lint:all": "yarn lint && yarn lint:auth && yarn lint:devdash",
    "test": "node --test src/**/*.test.js",
    "docker:lint": "docker compose run --rm --entrypoint \"yarn lint\" proxy",
    "docker:test": "docker compose run --rm --entrypoint \"yarn test\" proxy"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "express": "^4.18.3",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "standard": "^17.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
